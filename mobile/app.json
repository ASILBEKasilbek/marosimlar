{
  "expo": {
    "name": "TuyBox",
    "slug": "tuybox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.asilbek.tuybox",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Eng yaqin to'yxonalarni xaritada topish va masofani hisoblash uchun joylashuvingiz kerak."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.jpg",
        "backgroundColor": "#0A0A0C"
      },
      "package": "tech.asilbek.tuybox",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./src/assets/logo.jpg"
    }
  }
}
